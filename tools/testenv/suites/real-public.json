{
  "schema_version": 1,
  "id": "public-reference",
  "description": "Network opt-in: real gait SIMUL plus separately published VINS-Mono trajectory, NOT live Android VIO",
  "jobs": [
    {
      "id": "simul-java",
      "dataset": "simul",
      "engine": "android-pdr",
      "timeout_s": 1800,
      "checks": [
        {
          "field": "actual_estimator_executed",
          "equals": true
        },
        {
          "field": "reference_used_to_score",
          "equals": true
        },
        {
          "field": "metrics.test_cases",
          "min": 12
        },
        {
          "field": "metrics.original_sensor_timestamps",
          "min": 40000
        }
      ]
    },
    {
      "id": "published-vins",
      "dataset": "euroc_external",
      "engine": "external-vins",
      "timeout_s": 900,
      "checks": [
        {
          "field": "actual_estimator_executed",
          "equals": false
        },
        {
          "field": "reference_used_to_score",
          "equals": true
        },
        {
          "field": "metrics.pairs",
          "min": 3000
        }
      ]
    }
  ]
}
